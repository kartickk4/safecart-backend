# =================================================================
# SafeCart Backend Environment Variables Template
# Copy this file to .env and replace placeholders with real secrets.
# DO NOT commit .env into source control!
# =================================================================

# Server & Network Configuration
PORT=5001
NODE_ENV=production

# MongoDB Database Connection String
# Get this from MongoDB Atlas -> Database -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/safecart?retryWrites=true&w=majority

# JWT Token Encryption Secret (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_32_byte_hex_secret_here

# Frontend Application URLs for CORS Whitelisting (comma-separated, without trailing slash)
FRONTEND_URL=https://safecart.app,https://safecart-frontend.onrender.com,http://localhost:5173

# Cashfree Escrow & Payment Gateway
# In development: CASHFREE_ENV=TEST (with TEST App ID and Secret)
# In production:  CASHFREE_ENV=PRODUCTION (requires completed KYC and active merchant account)
CASHFREE_ENV=TEST
CASHFREE_APP_ID=TEST_OR_LIVE_APP_ID
CASHFREE_SECRET_KEY=TEST_OR_LIVE_SECRET_KEY

# Live Carrier & Shipment Tracking API (TrackCourier / Shiprocket / Delhivery)
CARRIER_TRACKING_MOCK=false
CARRIER_TRACKING_API_KEY=your_carrier_tracking_api_key_here
DEFAULT_CARRIER=delhivery
ENABLE_TRACKING_CRON=true

# Geolocation & Reverse Geocoding (BigDataCloud)
BIGDATACLOUD_API_KEY=your_bigdatacloud_key_here

# Email Verification & Deliverability (Mailboxlayer / EmailVerifier API)
EMAIL_VERIFIER_API_KEY=your_email_verifier_key_here

# Shiprocket Master Account API Integration
SHIPROCKET_EMAIL=your_shiprocket_api_email_here
SHIPROCKET_PASSWORD=your_shiprocket_api_password_here
